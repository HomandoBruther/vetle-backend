@VetleApi_HostAddress = http://localhost:5119
# Write requests need the API key. It is read from the VETLE_API_KEY environment variable,
# so the key itself is never stored in this (committed) file.
@ApiKey = {{$processEnv VETLE_API_KEY}}

### Health check
GET {{VetleApi_HostAddress}}/api/health

### List projects
GET {{VetleApi_HostAddress}}/api/projects
Accept: application/json

### Create a project
POST {{VetleApi_HostAddress}}/api/projects
X-Api-Key: {{ApiKey}}
Content-Type: application/json

{
  "title": "Personal website",
  "description": "Angular + ASP.NET Core + MongoDB portfolio site.",
  "tags": ["angular", "dotnet", "mongodb"],
  "repositoryUrl": "https://github.com/HomandoBruther/vetle-backend"
}

### Get one project (paste an id from the list/create response)
GET {{VetleApi_HostAddress}}/api/projects/REPLACE_WITH_ID

### Update a project
PUT {{VetleApi_HostAddress}}/api/projects/REPLACE_WITH_ID
X-Api-Key: {{ApiKey}}
Content-Type: application/json

{
  "title": "Personal website (v2)",
  "description": "Now with a real API.",
  "tags": ["angular", "dotnet"]
}

### Delete a project
DELETE {{VetleApi_HostAddress}}/api/projects/REPLACE_WITH_ID
X-Api-Key: {{ApiKey}}

### Validation failure example (expect 400)
POST {{VetleApi_HostAddress}}/api/projects
X-Api-Key: {{ApiKey}}
Content-Type: application/json

{
  "title": "",
  "description": "missing title",
  "repositoryUrl": "not-a-url"
}

### Missing API key (expect 401)
DELETE {{VetleApi_HostAddress}}/api/projects/REPLACE_WITH_ID
